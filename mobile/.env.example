# Copy this file to .env and fill in your values.
# The app reads EXPO_PUBLIC_* variables at bundle time — never put secrets here.
# .env is gitignored; this template is the one that gets committed.

# Supabase (same project the web app uses)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Publishable key (Supabase's new name for the anon key) — public by design; RLS protects the data.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Base URL of the Next.js app — its /api/checkout and /api/newsletter routes
# are the backend for this mobile app.
# Local dev:  http://localhost:3000
# Production: https://your-app.vercel.app
EXPO_PUBLIC_API_URL=http://localhost:3000
